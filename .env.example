# Copia este archivo a .env y completa los valores. .env nunca se commitea.

# --- base de datos -----------------------------------------------------------
# DSN estandar de PostgreSQL. Hoy apunta a Supabase; el dia de la migracion se
# cambia solo este valor. No se usa ninguna funcionalidad propia de Supabase.
# Rol de solo lectura, sin permisos de escritura en ningun esquema.
DATABASE_URL=postgresql://mira_query:PASSWORD@HOST:5432/postgres?sslmode=require
# Rol minimo de escritura, solo sobre el esquema analytics.
DATABASE_URL_LOG=postgresql://mira_logger:PASSWORD@HOST:5432/postgres?sslmode=require

POOL_MIN_SIZE=2
POOL_MAX_SIZE=8
STATEMENT_TIMEOUT_MS=8000

# --- modelo de lenguaje ------------------------------------------------------
ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-4-5-20251001
# Modelo que genera el SQL. No hay catalogo de consultas: toda pregunta se responde
# con SQL generado, validado por sqlglot antes de ejecutarse.
SQL_MODEL=claude-sonnet-5

# --- identificacion del solicitante y proteccion del presupuesto -------------
# Secreto HMAC para el token anonimo de cuota y para el hash del prefijo de red. Sin
# valor por defecto: es obligatorio.
TOKEN_HMAC_SECRET=
# Cloudflare Turnstile. Vacio permite arrancar en desarrollo sin el desafio.
TURNSTILE_SECRET=

# --- limites -----------------------------------------------------------------
MAX_QUESTION_CHARS=400
MAX_ROWS=500
QUOTA_PER_DAY=5
QUOTA_PER_MONTH=15
BUDGET_DAILY_USD=3.5
BUDGET_MONTHLY_USD=100.0

# --- versionado, para atribuir regresiones -----------------------------------
PROMPT_VERSION=0.1.0
APP_VERSION=0.1.0

# --- red ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
