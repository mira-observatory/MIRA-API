# Copia este archivo a .env y completa los valores. .env nunca se commitea.

# --- base de datos -----------------------------------------------------------
# DSN estandar de PostgreSQL. Hoy apunta a Supabase; el dia de la migracion se
# cambia solo este valor. No se usa ninguna funcionalidad propia de Supabase.
# Rol de solo lectura, sin permisos de escritura en ningun esquema.
DATABASE_URL=postgresql://mira_query:PASSWORD@HOST:5432/postgres?sslmode=require
# Rol de solo lectura, exclusivamente sobre web.coverage_sources. Los endpoints
# que usan esta conexion ejecutan SQL fijo y no invocan al modelo.
DATABASE_URL_WEB=postgresql://mira_web:PASSWORD@HOST:5432/postgres?sslmode=require
# Rol minimo de escritura, solo sobre el esquema analytics.
DATABASE_URL_LOG=postgresql://mira_logger:PASSWORD@HOST:5432/postgres?sslmode=require

POOL_MIN_SIZE=2
POOL_MAX_SIZE=8
WEB_POOL_MAX_SIZE=4
STATEMENT_TIMEOUT_MS=8000

# --- modelo de lenguaje ------------------------------------------------------
# No hay catalogo: toda pregunta contestable se responde con SQL generado.
ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-4-5-20251001
# claude-opus-5 o claude-sonnet-5 para la generacion de SQL.
SQL_MODEL=claude-sonnet-5

# --- limites -----------------------------------------------------------------
MAX_QUESTION_CHARS=400
MAX_ROWS=500

# Cuota por sujeto (generosa: solo acota abuso, no protege el presupuesto).
QUOTA_PER_DAY=5
QUOTA_PER_MONTH=15

# Cortacircuitos global de presupuesto (esto si protege el presupuesto de 100 USD/mes).
BUDGET_DAILY_USD=3.50
BUDGET_MONTHLY_USD=100.0

# --- versionado, para atribuir regresiones -----------------------------------
PROMPT_VERSION=0.1.0
APP_VERSION=0.1.0

# --- red ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
