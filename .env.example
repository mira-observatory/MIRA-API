# Plantilla unica: copiar a .env para desarrollo o .env.digitalocean para
# Docker Compose en DigitalOcean. Completar los valores de cada ambiente.
# Los archivos con credenciales reales nunca se commitean.

# --- base de datos -----------------------------------------------------------
# DSN estandar de PostgreSQL, independiente del proveedor. Reemplazar HOST,
# PASSWORD, puerto y nombre de base con los datos del ambiente.
# En el despliegue actual de DigitalOcean: puerto 25060 y base mira.
# Usar los tres roles de la API, nunca el usuario administrador.
# Rol de solo lectura, sin permisos de escritura en ningun esquema.
DATABASE_URL_QUERY=postgresql://mira_query:PASSWORD@HOST:5432/postgres?sslmode=require
# Rol de solo lectura, exclusivamente sobre tablas publicas del esquema web.
# Los endpoints que usan esta conexion ejecutan SQL fijo y no invocan al modelo.
DATABASE_URL_WEB=postgresql://mira_web:PASSWORD@HOST:5432/postgres?sslmode=require
# Rol minimo de escritura, solo sobre el esquema analytics.
DATABASE_URL_LOG=postgresql://mira_logger:PASSWORD@HOST:5432/postgres?sslmode=require

POOL_MIN_SIZE=1
POOL_MAX_SIZE=4
POOL_TIMEOUT_S=15
LOG_POOL_MIN_SIZE=0
LOG_POOL_MAX_SIZE=4
WEB_POOL_MIN_SIZE=0
WEB_POOL_MAX_SIZE=2
STATEMENT_TIMEOUT_MS=8000

# --- modelo de lenguaje ------------------------------------------------------
# No hay catalogo: toda pregunta contestable se responde con SQL generado.
ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-4-5-20251001
# Modelo que genera el SQL. No hay catalogo de consultas: toda pregunta se responde
# con SQL generado, validado por sqlglot antes de ejecutarse.
SQL_MODEL=claude-sonnet-5

# --- identificacion del solicitante y proteccion del presupuesto -------------
# Secreto HMAC para desarrollo local. Cambialo en staging/produccion.
TOKEN_HMAC_SECRET=dev-only-token-hmac-secret-change-me-before-deploy
# Cloudflare Turnstile. Vacio permite arrancar en desarrollo sin el desafio.
TURNSTILE_SECRET=
# SameSite de la cookie anonima. "lax" sirve entre subdominios HTTPS del mismo
# sitio; entre sitios distintos usar "none". Las cookies requieren HTTPS.
COOKIE_SAMESITE=lax

# --- limites -----------------------------------------------------------------
MAX_QUESTION_CHARS=400
MAX_ROWS=500
# Intento inicial incluido. Deben ser enteros mayores que cero.
SQL_MAX_ATTEMPTS=3
NARRATIVE_MAX_ATTEMPTS=2
NARRATIVE_MAX_ROWS_IN_PROMPT=25
QUOTA_PER_DAY=5
QUOTA_PER_MONTH=15
ENABLE_SUBJECT_QUOTA=false
# Acordado el 2026-08-18: 75 USD al mes, repartido parejo en los dias.
# Deben coincidir con los valores por defecto de config.py.
BUDGET_DAILY_USD=2.5
BUDGET_MONTHLY_USD=75.0

# --- versionado, para atribuir regresiones -----------------------------------
PROMPT_VERSION=0.1.0
APP_VERSION=0.1.0
# Docker Compose: etiqueta de la imagen; asignar una nueva en cada construccion.
# La aplicacion no utiliza esta variable al ejecutarse fuera de Compose.
MIRA_IMAGE_TAG=local

# --- red ---------------------------------------------------------------------
# Origen exacto de la web, sin barra final; varios origenes separados por coma.
# En despliegue reemplazar localhost por la URL real del frontend.
CORS_ORIGINS=http://localhost:5173
# Uvicorn: prefijo externo cuando Nginx publica la API en /api.
# Dejar vacio en desarrollo; usar /api en DigitalOcean (tambien para /api/docs).
UVICORN_ROOT_PATH=
